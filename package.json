{
  "name": "@cocreate/waveform",
  "version": "1.0.0",
  "description": "Declarative audio waveform analysis and visualization for CoCreate using the Web Audio API.",
  "keywords": [
    "waveform",
    "web-audio-api",
    "audio-context",
    "analyser-node",
    "audio-visualization",
    "microphone",
    "canvas",
    "accessibility",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "Declarative audio waveform analysis and visualization for CoCreate using the Web Audio API.",
      "source": "src/index.js",
      "declarative": {
        "selectors": [
          "[waveform-query], [waveform]"
        ],
        "attributes": [
          {
            "name": "actions"
          },
          {
            "name": "aria-disabled"
          },
          {
            "name": "waveform"
          },
          {
            "name": "waveform-active"
          },
          {
            "name": "waveform-fft-size"
          },
          {
            "name": "waveform-query"
          },
          {
            "name": "waveform-visualization"
          }
        ]
      },
      "api": {
        "exports": [
          "init",
          "start",
          "stop",
          "toggle"
        ]
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocreatejs/cocreate-waveform.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-waveform/issues"
  },
  "homepage": "https://cocreate.app/docs/waveform",
  "funding": {
    "type": "GitHub Sponsors \u2764",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/actions": "^1.24.0",
    "@cocreate/observer": "^1.23.0",
    "@cocreate/utils": "^1.54.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/observer@1.19.0": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
